---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props extends SEOProps {
  overlayHeader?: boolean;
  preloadImage?: { srcset: string; sizes: string } | null;
}
const { overlayHeader = false, preloadImage, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#271d0f" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}
    <SEO {...seo} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // ClientRouter replaces <html> attributes on navigation; keep the flag.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main" class:list={{ 'main--offset': !overlayHeader }}>
      <slot />
    </main>
    <Footer />

    <style is:global>
      .main--offset { padding-top: var(--header-h); }
    </style>

    <script>
      // Cookie-less page-view beacon for the cockpit analytics. After a client-side
      // navigation document.referrer is stale, so the previous URL is tracked instead.
      let previous = document.referrer;
      document.addEventListener('astro:page-load', () => {
        if (navigator.webdriver) return;
        const body = JSON.stringify({
          p: location.pathname,
          r: previous,
          tz: Intl.DateTimeFormat().resolvedOptions().timeZone,
          l: navigator.language,
        });
        previous = location.href;
        try {
          navigator.sendBeacon('/api/hit/', new Blob([body], { type: 'text/plain' }));
        } catch {}
      });
    </script>

    <script>
      // Reveal-on-scroll: cheap IntersectionObserver, re-armed after each client-side navigation.
      let io: IntersectionObserver | undefined;
      document.addEventListener('astro:page-load', () => {
        io?.disconnect();
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!('IntersectionObserver' in window)) return items.forEach((el) => el.classList.add('is-in'));
        io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io?.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io!.observe(el));
      });
    </script>
  </body>
</html>
