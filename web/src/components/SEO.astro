---
import { site } from '../config/site';
import { organization, website, breadcrumbs, abs } from '../lib/schema';
import { clip } from '../lib/content';

export interface Props {
  title: string;
  description: string;
  image?: string | null;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  article?: { published: string; modified?: string; author: string; section?: string };
}

const { title, description, image, imageAlt, type = 'website', noindex = false, crumbs, schema = [], article } = Astro.props;

const isHome = Astro.url.pathname === '/';
const brandTitle = (t: string) =>
  t.length + site.name.length + 3 <= 62 ? `${t} | ${site.name}` : t.length + 14 <= 64 ? `${t} | Wingu Elite` : t;
const fullTitle = isHome ? `${site.name} | ${site.tagline}` : brandTitle(title);
const metaDescription = clip(description, 158);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = abs(image || '/og-default.jpg');

const graph = [
  organization(),
  ...(isHome ? [website()] : []),
  ...(crumbs?.length ? [breadcrumbs([{ name: 'Home', href: '/' }, ...crumbs])] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="author" content={article?.author ?? site.name} />
<meta name="creator" content={`${site.developer.name} (${site.developer.handle}), ${site.developer.url}`} />
<meta name="designer" content={`${site.developer.name}, ${site.developer.email}, ${site.developer.phone}`} />
<meta name="web_author" content={`${site.developer.name} <${site.developer.email}>, ${site.developer.url}`} />
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
<link rel="author" href="/humans.txt" />
<meta name="geo.region" content="KE" />
<meta name="geo.placename" content="Nairobi" />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={isHome ? fullTitle : title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{article && (
  <>
    <meta property="article:published_time" content={article.published} />
    {article.modified && <meta property="article:modified_time" content={article.modified} />}
    {article.section && <meta property="article:section" content={article.section} />}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={isHome ? fullTitle : title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={jsonLd} />
