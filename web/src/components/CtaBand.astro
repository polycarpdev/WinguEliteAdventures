---
import { site } from '../config/site';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Your safari, designed around you',
  text = 'Tell us when you’d like to travel and what moves you. A Wingu specialist will craft a private itinerary and send you a quote within 24 hours.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner" data-reveal>
    <span class="eyebrow">Karibu</span>
    <h2 class="h2">{title}</h2>
    <p class="lead">{text}</p>
    <div class="cta-band__actions">
      <a href="/bookings/" class="btn btn--gold btn--lg">Start planning <Icon name="arrow-right" /></a>
      {site.whatsapp
        ? <a href={`https://wa.me/${site.whatsapp}`} class="btn btn--ghost btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
        : <a href="/contact/" class="btn btn--ghost btn--lg">Ask a question</a>}
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; overflow: hidden; background: var(--olive-900); color: var(--cream); padding-block: clamp(4.5rem, 9vw, 7rem); text-align: center; }
  .cta-band::before, .cta-band::after {
    content: ''; position: absolute; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(202 168 103 / 0.28), transparent);
  }
  .cta-band::before { width: 40rem; height: 22rem; left: -12rem; top: -10rem; }
  .cta-band::after { width: 34rem; height: 20rem; right: -10rem; bottom: -10rem; }
  .cta-band__inner { position: relative; display: grid; justify-items: center; gap: 1rem; max-width: 50rem; }
  .cta-band .eyebrow { color: var(--gold-300); }
  .cta-band .lead { color: rgb(247 242 234 / 0.8); }
  .cta-band__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 1rem; }
</style>
