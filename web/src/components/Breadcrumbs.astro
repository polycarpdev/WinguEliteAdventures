---
interface Props { items: { name: string; href: string }[]; light?: boolean }
const { items, light = false } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...items];
---
<nav aria-label="Breadcrumb" class:list={['crumbs', { 'crumbs--light': light }]}>
  <ol>
    {all.map((item, i) => (
      <li>
        {i < all.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: 0.82rem; color: var(--muted); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .crumbs li + li::before { content: '/'; opacity: 0.5; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--olive); }
  .crumbs [aria-current] { color: var(--ink); font-weight: 600; max-width: 22rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crumbs--light, .crumbs--light [aria-current] { color: rgb(247 242 234 / 0.85); }
  .crumbs--light a:hover { color: var(--gold-300); }
</style>
