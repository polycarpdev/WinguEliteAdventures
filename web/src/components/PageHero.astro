---
import type { Img as ImgT } from '../lib/content';
import Img from './Img.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: ImgT | null;
  crumbs?: { name: string; href: string }[];
  size?: 'md' | 'lg';
}
const { title, eyebrow, lead, image, crumbs, size = 'md' } = Astro.props;
---
<section class:list={['page-hero', `page-hero--${size}`, { 'page-hero--image': image }]}>
  {image && (
    <div class="page-hero__bg">
      <Img image={image} sizes="100vw" eager alt="" />
    </div>
  )}
  <div class="container page-hero__inner">
    {crumbs && <Breadcrumbs items={crumbs} light={!!image} />}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="h1 page-hero__title">{title}</h1>
    {lead && <p class="lead page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { position: relative; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); background: var(--sand); overflow: hidden; }
  .page-hero::after {
    content: ''; position: absolute; right: -6rem; top: -4rem; width: 26rem; height: 18rem; pointer-events: none;
    background: radial-gradient(closest-side, rgb(202 168 103 / 0.35), transparent); filter: blur(10px);
  }
  .page-hero__inner { position: relative; z-index: 1; display: grid; gap: 0.75rem; justify-items: start; }
  .page-hero__title { max-width: 52rem; }
  .page-hero__lead { margin-top: 0.4rem; }

  .page-hero--image { color: var(--cream); background: var(--ink); min-height: clamp(22rem, 52vh, 34rem); display: flex; align-items: flex-end; padding-top: calc(var(--header-h) + 4rem); }
  .page-hero--lg.page-hero--image { min-height: clamp(26rem, 72vh, 46rem); }
  .page-hero--image::after { display: none; }
  .page-hero--image .eyebrow { color: var(--gold-300); }
  .page-hero--image .page-hero__lead { color: rgb(247 242 234 / 0.85); }
  .page-hero__bg { position: absolute; inset: 0; }
  .page-hero__bg :global(img), .page-hero__bg :global(.img-fallback) { width: 100%; height: 100%; object-fit: cover; }
  .page-hero__bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(39 29 15 / 0.55) 0%, rgb(39 29 15 / 0.15) 35%, rgb(39 29 15 / 0.82) 100%);
  }
</style>
