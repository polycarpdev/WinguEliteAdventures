---
// Accessible <dialog> lightbox for any [data-lightbox] link group. ~1KB of JS.
import Icon from './Icon.astro';
---
<dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
  <button class="lightbox__btn lightbox__close" data-lb="close" aria-label="Close"><Icon name="x" /></button>
  <button class="lightbox__btn lightbox__prev" data-lb="prev" aria-label="Previous photo"><Icon name="arrow-left" /></button>
  <figure>
    <img alt="" data-lb-img />
    <figcaption data-lb-caption></figcaption>
  </figure>
  <button class="lightbox__btn lightbox__next" data-lb="next" aria-label="Next photo"><Icon name="arrow-right" /></button>
</dialog>

<style>
  .lightbox { width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; padding: 0; border: 0; background: rgb(20 15 8 / 0.96); color: var(--cream); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox figure { display: grid; gap: 0.75rem; justify-items: center; margin: 0; padding: 4rem 4.5rem; max-height: 100%; }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 9rem); width: auto; height: auto; object-fit: contain; border-radius: var(--radius-sm); }
  .lightbox figcaption { font-size: 0.92rem; color: rgb(247 242 234 / 0.8); text-align: center; }
  .lightbox__btn { position: absolute; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: rgb(247 242 234 / 0.1); color: var(--cream); transition: background 0.2s; }
  .lightbox__btn:hover { background: rgb(247 242 234 / 0.22); }
  .lightbox__btn :global(svg) { width: 1.3rem; height: 1.3rem; }
  .lightbox__close { top: 1rem; right: 1rem; }
  .lightbox__prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lightbox__next { right: 1rem; top: 50%; translate: 0 -50%; }
  @media (max-width: 639.98px) {
    .lightbox figure { padding: 4rem 0.5rem 5rem; }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 1rem; translate: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
    if (!dialog || !links.length) return;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      img.src = a.href;
      img.srcset = a.dataset.srcset ?? '';
      img.sizes = '100vw';
      img.alt = a.dataset.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      // warm the next image
      const next = links[(index + 1) % links.length];
      if (next) new Image().src = next.href;
    };

    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); dialog.showModal(); }));
    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close' || e.target === dialog) dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    let x0 = 0;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  });
</script>
