---
// Brand mark: the gold-rimmed cloud from the Wingu logo, simplified for small sizes.
const { class: cls } = Astro.props as { class?: string };
---
<svg class={cls} viewBox="0 0 64 44" aria-hidden="true">
  <path
    d="M14.5 40C7.6 40 3 35.4 3 29.6c0-5.2 3.8-9.4 8.9-10.1C13 11.7 19.6 6 27.6 6c6.3 0 11.7 3.5 14.4 8.7 1.3-.4 2.6-.6 4-.6 7.6 0 13.8 6.1 13.8 13.6S53.6 40 46 40H14.5Z"
    fill="var(--cloud-fill, #f7f2ea)"
    stroke="var(--cloud-stroke, #caa867)"
    stroke-width="3.2"
  />
  <path d="M10 31c9-6 19-6.5 30-2.5 6 2.2 11 2 15-.5" fill="none" stroke="var(--cloud-stroke, #caa867)" stroke-width="2.4" stroke-linecap="round" opacity=".9" />
</svg>
