---
const { class: cls } = Astro.props as { class?: string };
---
<a href="/" class:list={['brand', cls]} aria-label="Wingu Elite Adventures, home">
  <img
    src="/brand/logo-h120.webp"
    srcset="/brand/logo-h120.webp 131w, /brand/logo-h240.webp 262w"
    sizes="10rem"
    width="131"
    height="120"
    alt="Wingu Elite Adventures"
    class="brand__logo"
    fetchpriority="high"
  />
</a>
<style>
  .brand { display: inline-flex; align-items: center; height: 100%; }
  .brand__logo {
    height: calc(var(--header-h) - 0.6rem);
    width: auto;
    filter: drop-shadow(0 2px 6px rgb(39 29 15 / 0.18));
  }
</style>
