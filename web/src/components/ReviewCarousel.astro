---
// Endless review slider: 3 cards on large screens, 2 on tablets, 1 on phones.
// Moves one card every 5 seconds; pauses on hover, when the tab is hidden, or
// for visitors who prefer reduced motion.
import type { Testimonial } from '../lib/content';
import TestimonialCard from './TestimonialCard.astro';

interface Props { items: Testimonial[] }
const { items } = Astro.props;
// Repeat short lists so the track is always wider than 3 cards, then add one
// full copy at the end so the loop can jump back invisibly.
const base = items.length >= 4 ? items : Array.from({ length: Math.ceil(4 / items.length) }, () => items).flat();
const track = [...base, ...base];
---
<div class="reviews-carousel" data-carousel data-count={base.length} aria-roledescription="carousel" aria-label="Guest reviews">
  <div class="reviews-carousel__viewport">
    <ul class="reviews-carousel__track" data-track>
      {track.map((t, i) => (
        <li class="reviews-carousel__slide" aria-hidden={i >= items.length ? 'true' : undefined}>
          <TestimonialCard t={t} />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .reviews-carousel { --per: 1; --gap: 1.25rem; }
  @media (min-width: 700px) { .reviews-carousel { --per: 2; } }
  @media (min-width: 1100px) { .reviews-carousel { --per: 3; --gap: 1.75rem; } }
  .reviews-carousel__viewport { overflow: hidden; margin: -1rem; padding: 1rem; } /* room for card shadows */
  .reviews-carousel__track {
    list-style: none; padding: 0; margin: 0; display: flex; gap: var(--gap);
    transition: transform 0.9s var(--ease); will-change: transform;
  }
  .reviews-carousel__slide { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); display: flex; }
  .reviews-carousel__slide > :global(*) { flex: 1; opacity: 1 !important; transform: none !important; }
</style>

<script>
  const timers = new Set<number>();
  let resizeHooks: (() => void)[] = [];
  window.addEventListener('resize', () => resizeHooks.forEach((f) => f()), { passive: true });

  function init() {
    timers.forEach((t) => clearInterval(t));
    timers.clear();
    resizeHooks = [];
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-track]')!;
      const count = Number(root.dataset.count);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || count < 2) return;
      let index = 0;
      let paused = false;

      const step = () => {
        const slide = track.children[0] as HTMLElement;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return slide.getBoundingClientRect().width + gap;
      };
      const move = (animate: boolean) => {
        track.style.transition = animate ? '' : 'none';
        track.style.transform = `translateX(${-index * step()}px)`;
      };
      const next = () => {
        if (paused || document.hidden) return;
        index += 1;
        move(true);
      };
      // After sliding onto the copy, jump back to the matching original card.
      track.addEventListener('transitionend', () => {
        if (index >= count) {
          index -= count;
          move(false);
        }
      });
      root.addEventListener('mouseenter', () => (paused = true));
      root.addEventListener('mouseleave', () => (paused = false));
      root.addEventListener('focusin', () => (paused = true));
      root.addEventListener('focusout', () => (paused = false));
      resizeHooks.push(() => move(false));

      timers.add(window.setInterval(next, 5000));
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => timers.forEach((t) => clearInterval(t)));
</script>
