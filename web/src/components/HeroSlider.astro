---
import type { HeroSlide } from '../lib/content';
import { site } from '../config/site';
import Icon from './Icon.astro';
import TripFinder from './TripFinder.astro';

interface Props { slides: HeroSlide[] }
const { slides } = Astro.props;
const MOBILE = '(max-width: 767px)';
const many = slides.length > 1;
---
<section class="hero" data-hero aria-roledescription={many ? 'carousel' : undefined} aria-label="Featured journeys">
  <div class="hero__slides">
    {slides.map((s, i) => {
      const eager = i === 0;
      return (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
          <picture>
            {s.mobile && (
              eager
                ? <source media={MOBILE} srcset={s.mobile.srcset} sizes="100vw" />
                : <source media={MOBILE} data-srcset={s.mobile.srcset} sizes="100vw" />
            )}
            {eager ? (
              <img src={s.desktop.src} srcset={s.desktop.srcset} sizes="100vw" width={s.desktop.width} height={s.desktop.height}
                   alt={s.desktop.alt} fetchpriority="high" decoding="async" />
            ) : (
              <img data-src={s.desktop.src} data-srcset={s.desktop.srcset} sizes="100vw" width={s.desktop.width} height={s.desktop.height}
                   alt={s.desktop.alt} decoding="async" />
            )}
          </picture>
        </div>
      );
    })}
  </div>

  <div class="container hero__inner">
    <div class="hero__copies">
      {slides.map((s, i) => (
        <div class:list={['hero__copy', { 'is-active': i === 0 }]} data-copy aria-hidden={i === 0 ? undefined : 'true'}>
          {s.eyebrow && <span class="eyebrow hero__eyebrow">{s.eyebrow}</span>}
          {i === 0
            ? <h1 class="display hero__title">{s.headline}{s.highlight && <><br /><em>{s.highlight}</em></>}</h1>
            : <p class="display hero__title">{s.headline}{s.highlight && <><br /><em>{s.highlight}</em></>}</p>}
          {s.subtitle && <p class="hero__lead">{s.subtitle}</p>}
          <div class="hero__actions">
            <a href={s.button.url} class="btn btn--gold btn--lg" tabindex={i === 0 ? undefined : -1}>{s.button.label} <Icon name="arrow-right" /></a>
            {s.second && <a href={s.second.url} class="btn btn--ghost btn--lg" tabindex={i === 0 ? undefined : -1}>{s.second.label}</a>}
          </div>
        </div>
      ))}
    </div>

    <TripFinder />

    {many && (
      <div class="hero__nav">
        <button type="button" class="hero__arrow" data-prev aria-label="Previous slide"><Icon name="arrow-left" /></button>
        <div class="hero__dots" role="tablist" aria-label="Choose slide">
          {slides.map((s, i) => (
            <button type="button" role="tab" class:list={['hero__dot', { 'is-active': i === 0 }]} data-dot={i}
                    aria-label={`Slide ${i + 1}: ${s.headline}`} aria-selected={i === 0 ? 'true' : 'false'}></button>
          ))}
        </div>
        <button type="button" class="hero__arrow" data-next aria-label="Next slide"><Icon name="arrow-right" /></button>
      </div>
    )}

  </div>

  {many && (
    <>
      <button type="button" class="hero__edge hero__edge--prev" data-prev aria-label="Previous slide"><Icon name="arrow-left" /></button>
      <button type="button" class="hero__edge hero__edge--next" data-next aria-label="Next slide"><Icon name="arrow-right" /></button>
    </>
  )}

  <div class="hero__stats">
    <div class="container">
      <ul>{site.stats.map((st) => <li><strong>{st.value}</strong><span>{st.label}</span></li>)}</ul>
    </div>
  </div>
</section>

<style>
  .hero {
    --slide-ms: 7000ms;
    position: relative; isolation: isolate; color: var(--cream);
    min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-rows: 1fr auto; background: var(--ink); overflow: hidden;
  }
  .hero__slides { position: absolute; inset: 0; z-index: -1; }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__slide.is-active { opacity: 1; }
  .hero__slide picture, .hero__slide img { width: 100%; height: 100%; }
  .hero__slide img { object-fit: cover; transform: scale(1.08); transition: transform 9s cubic-bezier(0.25, 0.1, 0.25, 1); }
  .hero__slide.is-active img { transform: scale(1); }
  .hero__slides::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgb(39 29 15 / 0.6) 0%, rgb(39 29 15 / 0.25) 30%, rgb(39 29 15 / 0.35) 65%, rgb(39 29 15 / 0.9) 100%),
      radial-gradient(ellipse 60% 55% at 50% 50%, rgb(39 29 15 / 0.35), transparent 75%);
  }

  .hero__inner {
    align-self: center; display: grid; justify-items: center; gap: clamp(1.75rem, 3vw, 2.5rem); text-align: center;
    padding-top: calc(var(--header-h) + var(--topbar-h) + 3rem); padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .hero__copies { display: grid; width: 100%; }
  .hero__copy { grid-area: 1 / 1; display: grid; justify-items: center; align-content: center; gap: 1rem; visibility: hidden; }
  .hero__copy.is-active { visibility: visible; }
  .hero__copy > * { opacity: 0; transform: translateY(1.4rem); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease); }
  .hero__copy.is-active > * { opacity: 1; transform: none; }
  .hero__copy.is-active > :nth-child(2) { transition-delay: 0.08s; }
  .hero__copy.is-active > :nth-child(3) { transition-delay: 0.16s; }
  .hero__copy.is-active > :nth-child(4) { transition-delay: 0.24s; }
  .hero__eyebrow { color: var(--gold-300); font-size: clamp(1.7rem, 2.6vw, 2.4rem); margin: 0; text-shadow: 0 2px 18px rgb(0 0 0 / 0.35); }
  .hero__title { max-width: 20ch; font-family: var(--serif); font-weight: 400; font-size: clamp(2.3rem, 4.4vw, 3.9rem); line-height: 1.08; text-shadow: 0 2px 30px rgb(0 0 0 / 0.35); }
  .hero__title :global(em) { font-style: italic; color: var(--gold-100); }
  .hero__lead { font-size: clamp(1rem, 1.2vw, 1.12rem) !important; max-width: 36rem; margin-inline: auto; font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: rgb(247 242 234 / 0.88); }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 0.2rem; }

  .hero__nav { display: flex; align-items: center; justify-content: center; gap: 0.9rem; }
  .hero__dots { display: flex; align-items: center; gap: 0.55rem; }
  .hero__dot {
    width: 0.65rem; height: 0.65rem; padding: 0; border-radius: 999px;
    background: rgb(247 242 234 / 0.45); box-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
    transition: width 0.35s var(--ease), background 0.25s;
  }
  .hero__dot:hover { background: rgb(247 242 234 / 0.8); }
  .hero__dot.is-active { width: 1.6rem; background: var(--gold-300); }
  .hero__arrow {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 999px;
    color: var(--cream); background: rgb(247 242 234 / 0.15); transition: background 0.2s;
  }
  .hero__arrow:hover { background: var(--gold-300); color: var(--ink); }
  .hero__arrow :global(svg) { width: 1rem; height: 1rem; }

  .hero__edge {
    position: absolute; top: 50%; z-index: 2; display: none; place-items: center; width: 3.6rem; height: 3.6rem;
    border-radius: 999px; color: var(--cream); background: rgb(247 242 234 / 0.12);
    border: 1px solid rgb(247 242 234 / 0.3); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transform: translateY(-50%); transition: background 0.25s, color 0.25s, transform 0.25s var(--ease), border-color 0.25s;
  }
  .hero__edge--prev { left: clamp(1rem, 2.5vw, 2.5rem); }
  .hero__edge--next { right: clamp(1rem, 2.5vw, 2.5rem); }
  .hero__edge:hover { background: var(--gold-300); border-color: var(--gold-300); color: var(--ink); }
  .hero__edge--prev:hover { transform: translateY(-50%) translateX(-3px); }
  .hero__edge--next:hover { transform: translateY(-50%) translateX(3px); }
  .hero__edge :global(svg) { width: 1.35rem; height: 1.35rem; }
  @media (min-width: 900px) {
    .hero__edge { display: grid; }
    .hero__nav .hero__arrow { display: none; }
  }

  .hero__stats { border-top: 1px solid rgb(247 242 234 / 0.18); background: rgb(39 29 15 / 0.35); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .hero__stats ul { list-style: none; padding: 1.25rem 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (min-width: 900px) { .hero__stats ul { grid-template-columns: repeat(4, 1fr); } }
  .hero__stats li { display: grid; gap: 0.1rem; }
  .hero__stats strong { font-family: var(--serif); font-weight: 500; font-size: clamp(1.4rem, 2.2vw, 1.9rem); color: var(--gold-100); line-height: 1.1; }
  .hero__stats span { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(247 242 234 / 0.7); }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide, .hero__slide img, .hero__copy > * { transition: none; }
    .hero__slide img { transform: none; }
  }
</style>

<script>
  let timer: number | undefined;
  let onVisibility: (() => void) | undefined;

  function initHero() {
    clearTimeout(timer);
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const copies = [...hero.querySelectorAll<HTMLElement>('[data-copy]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (slides.length < 2) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ms = 7000;
    let index = 0;
    let paused = false;
    if (reduce) hero.setAttribute('data-static', '');

    const load = (i: number) => {
      slides[i]?.querySelectorAll<HTMLElement>('[data-srcset], [data-src]').forEach((el) => {
        if (el.dataset.srcset) { el.setAttribute('srcset', el.dataset.srcset); delete el.dataset.srcset; }
        if (el.dataset.src) { el.setAttribute('src', el.dataset.src); delete el.dataset.src; }
      });
    };

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      load(index);
      load(index + 1 === slides.length ? 0 : index + 1);
      [slides, copies].forEach((list) => list.forEach((el, n) => {
        el.classList.toggle('is-active', n === index);
        if (n === index) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      }));
      copies.forEach((c, n) => c.querySelectorAll('a').forEach((a) => (n === index ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1'))));
      dots.forEach((d, n) => {
        d.classList.remove('is-active');
        d.setAttribute('aria-selected', String(n === index));
      });
      void dots[index]?.offsetWidth;
      dots[index]?.classList.add('is-active');
      schedule();
    };

    const schedule = () => {
      clearTimeout(timer);
      if (reduce || paused) return;
      timer = window.setTimeout(() => show(index + 1), ms);
    };
    const setPaused = (p: boolean) => {
      paused = p;
      hero.toggleAttribute('data-paused', p);
      if (p) clearTimeout(timer); else schedule();
    };

    hero.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => show(index + 1)));
    hero.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => show(index - 1)));
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.dot))));
    hero.addEventListener('mouseenter', () => setPaused(true));
    hero.addEventListener('mouseleave', () => setPaused(false));
    hero.addEventListener('focusin', () => setPaused(true));
    hero.addEventListener('focusout', () => setPaused(false));
    hero.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 45) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    if (onVisibility) document.removeEventListener('visibilitychange', onVisibility);
    onVisibility = () => setPaused(document.hidden);
    document.addEventListener('visibilitychange', onVisibility);

    const first = slides[0].querySelector('img');
    const start = () => { load(1); schedule(); };
    if (first && !first.complete) first.addEventListener('load', start, { once: true }); else start();
  }

  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', () => clearTimeout(timer));
</script>
