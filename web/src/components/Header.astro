---
import { nav } from '../config/site';
import Brand from './Brand.astro';
import Icon from './Icon.astro';

const { overlay = false } = Astro.props as { overlay?: boolean };
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/destinations/kenya/' ? path.startsWith('/destinations/') : path.startsWith(href);
---
<header class="site-header" data-overlay={overlay ? '' : undefined} data-header>
  <div class="container site-header__inner">
    <Brand />
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="site-nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/bookings/" class="btn btn--gold site-nav__cta">Plan your safari</a>
    </nav>
    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="x" class="menu-toggle__close" />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background: rgb(247 242 234 / 0.9);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .site-header[data-overlay]:not([data-scrolled]):not([data-open]) {
    background: transparent; color: var(--cream); border-color: transparent;
    backdrop-filter: none; -webkit-backdrop-filter: none;
  }
  .site-header[data-overlay]:not([data-scrolled]):not([data-open]) :global(.brand__mark) {
    --cloud-fill: rgb(247 242 234 / 0.15);
  }
  .site-header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }

  .site-nav__list { list-style: none; padding: 0; display: flex; gap: 0.25rem; }
  .site-nav__link {
    position: relative; display: block; padding: 0.5rem 0.85rem;
    font-size: 0.92rem; font-weight: 600; text-decoration: none; opacity: 0.88;
    transition: opacity 0.2s;
  }
  .site-nav__link::after {
    content: ''; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.2rem; height: 1.5px;
    background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease);
  }
  .site-nav__link:hover, .site-nav__link[aria-current='page'] { opacity: 1; }
  .site-nav__link:hover::after, .site-nav__link[aria-current='page']::after { transform: scaleX(1); }

  .menu-toggle { display: none; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: 999px; color: inherit; }
  .menu-toggle :global(svg) { width: 1.6rem; height: 1.6rem; }
  .menu-toggle__close { display: none; }
  [data-open] .menu-toggle__open { display: none; }
  [data-open] .menu-toggle__close { display: block; }

  @media (min-width: 1100px) {
    .site-nav { display: flex; align-items: center; gap: 1.25rem; }
  }

  @media (max-width: 1099.98px) {
    .menu-toggle { display: grid; }
    .site-nav {
      position: fixed; inset: var(--header-h) 0 0; z-index: -1;
      display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
      padding: 2rem var(--gutter) calc(2rem + env(safe-area-inset-bottom));
      background: var(--cream); color: var(--ink);
      overflow-y: auto;
      opacity: 0; visibility: hidden; transform: translateY(-0.75rem);
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
    }
    [data-open] .site-nav { opacity: 1; visibility: visible; transform: none; }
    .site-nav__list { flex-direction: column; gap: 0; }
    .site-nav__link {
      padding: 1rem 0; font-family: var(--serif); font-size: 1.9rem; font-weight: 400;
      border-bottom: 1px solid var(--line); opacity: 1;
    }
    .site-nav__link::after { display: none; }
    .site-nav__link[aria-current='page'] { color: var(--olive); font-style: italic; }
    .site-nav__cta { width: 100%; min-height: 3.6rem; font-size: 1rem; }
  }
</style>

<script>
  let scrollBound = false;

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!header || !toggle) return;

    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('.site-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    const onScroll = () => {
      document.querySelector('[data-header]')?.toggleAttribute('data-scrolled', window.scrollY > 24);
    };
    onScroll();
    if (!scrollBound) {
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') document.querySelector<HTMLButtonElement>('[data-header][data-open] [data-menu-toggle]')?.click();
      });
      scrollBound = true;
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
