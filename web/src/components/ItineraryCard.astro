---
import type { Itinerary } from '../lib/content';
import { usd, stripHtml } from '../lib/content';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props { itinerary: Itinerary }
const { itinerary: i } = Astro.props;
---
<article class="card" data-reveal data-destination={i.destination.slug} data-difficulty={i.difficulty}>
  <div class="card__media">
    <div class="card__badges">
      <span class="badge">{i.duration_days} days</span>
      {i.is_featured && <span class="badge badge--gold">Signature</span>}
    </div>
    <Img image={i.image} sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw" alt={`${i.title} safari`} />
  </div>
  <div class="card__body">
    <div class="card__meta">
      <span><Icon name="pin" />{i.destination.name}</span>
    </div>
    <h3 class="card__title"><a href={`/itineraries/${i.slug}/`}>{i.title}</a></h3>
    <p class="muted clamp-2">{stripHtml(i.overview_html)}</p>
    <div class="card__meta">
      <span><Icon name="mountain" />{i.difficulty_label}</span>
      <span><Icon name="users" />Max {i.max_group_size}</span>
    </div>
    <div class="card__foot">
      <p class="price"><small>From</small>{usd(i.price_from)}<span class="muted" style="font-size:.8rem;font-family:var(--sans)"> pp</span></p>
      <span class="link-arrow">Details <Icon name="arrow-right" /></span>
    </div>
  </div>
</article>
<style>
  .badge--gold { background: var(--gold-300); }
</style>
