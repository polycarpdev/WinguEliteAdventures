---
import type { Itinerary } from '../lib/content';
import { usd, stripHtml, clip, shortDuration } from '../lib/content';
import Img from './Img.astro';
import Icon from './Icon.astro';

interface Props { itinerary: Itinerary }
const { itinerary: i } = Astro.props;
const blurb = i.summary || clip(stripHtml(i.overview_html), 130);
---
<article class="pkg" data-reveal data-destination={i.destination.slug} data-difficulty={i.difficulty} data-days={i.duration_days}>
  <div class="pkg__media">
    <Img image={i.image} sizes="(min-width: 1100px) 30vw, (min-width: 640px) 50vw, 100vw" alt={`${i.title} package`} />
    {i.badge && <span class="pkg__badge">{i.badge}</span>}
    <span class="pkg__dur" title={i.duration_label}><Icon name="clock" />{shortDuration(i.duration_days, i.duration_nights)}</span>
  </div>
  <div class="pkg__body">
    <p class="pkg__where"><Icon name="pin" />{i.destination.name}</p>
    <h3 class="pkg__title"><a href={`/packages/${i.slug}/`}>{i.title}</a></h3>
    <p class="pkg__blurb clamp-2">{blurb}</p>
    <div class="pkg__foot">
      {i.price_from == null
        ? <p class="pkg__price pkg__price--request">On Request</p>
        : <p class="pkg__price"><small>From</small>{usd(i.price_from)}<span> pp</span></p>}
      <span class="pkg__cta">View package <Icon name="arrow-right" /></span>
    </div>
  </div>
</article>

<style>
  .pkg {
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    border-radius: var(--radius); background: var(--white); box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .pkg:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .pkg__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--sand); }
  .pkg__media :global(img), .pkg__media :global(.img-fallback) { width: 100%; height: 100%; object-fit: cover; min-height: 0; transition: transform 0.9s var(--ease); }
  .pkg:hover .pkg__media :global(img) { transform: scale(1.05); }
  .pkg__badge {
    position: absolute; top: 0.9rem; left: 0.9rem; padding: 0.45rem 0.85rem; border-radius: 0.4rem;
    background: var(--ink); color: var(--gold-100); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
  }
  .pkg__dur {
    position: absolute; bottom: 0.8rem; right: 0.8rem; display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.35rem 0.7rem; border-radius: 999px; background: rgb(247 242 234 / 0.94); color: var(--ink);
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; backdrop-filter: blur(6px);
  }
  .pkg__dur :global(svg) { width: 0.9rem; height: 0.9rem; color: var(--olive); }
  .pkg__body { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.2rem 1.3rem 1.3rem; flex: 1; }
  .pkg__where { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); }
  .pkg__where :global(svg) { width: 0.9rem; height: 0.9rem; }
  .pkg__title { font-size: 1.22rem; line-height: 1.25; }
  .pkg__title a { text-decoration: none; }
  .pkg__title a::after { content: ''; position: absolute; inset: 0; }
  .pkg__blurb { font-size: 0.9rem; color: var(--muted); }
  .pkg__foot { margin-top: auto; padding-top: 0.9rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .pkg__price { font-family: var(--serif); font-size: 1.25rem; color: var(--olive); line-height: 1.1; }
  .pkg__price small { display: block; font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .pkg__price span { font-family: var(--sans); font-size: 0.78rem; color: var(--muted); }
  .pkg__price--request { font-family: var(--sans); font-size: 0.95rem; font-weight: 700; color: var(--ink); }
  .pkg__cta {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.7rem 1.05rem; border-radius: 0.5rem;
    background: var(--olive); color: var(--cream); font-size: 0.85rem; font-weight: 700; white-space: nowrap;
    transition: background 0.25s var(--ease);
  }
  .pkg__cta :global(svg) { width: 1rem; height: 1rem; transition: transform 0.25s var(--ease); }
  .pkg:hover .pkg__cta { background: var(--olive-900); }
  .pkg:hover .pkg__cta :global(svg) { transform: translateX(3px); }
</style>
