---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ItineraryCard from '../../../components/ItineraryCard.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import DurationPicker from '../../../components/DurationPicker.astro';
import { destinations, itinerariesFor, clip, countryUrl, type Destination } from '../../../lib/content';
import { abs } from '../../../lib/schema';

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Destination };
const trips = itinerariesFor(d.slug);
const nearby = destinations
  .filter((x) => x.slug !== d.slug && x.region.slug === d.region.slug)
  .sort((a, b) => Number(b.country.slug === d.country.slug) - Number(a.country.slug === d.country.slug))
  .slice(0, 3);
const countryHref = countryUrl(d.region.slug, d.country.slug);
const crumbs = [
  { name: 'Destinations', href: '/destinations/' },
  { name: d.region.name, href: `/destinations/${d.region.slug}/` },
  { name: d.country.name, href: countryHref },
  { name: d.name, href: `/destinations/detail/${d.slug}/` },
];
const schema = [{
  '@type': 'TouristDestination',
  name: d.name,
  description: clip(d.short_description, 300),
  url: abs(`/destinations/detail/${d.slug}/`),
  ...(d.image && { image: abs(d.image.src) }),
  containedInPlace: { '@type': 'Place', name: d.country.name, url: abs(countryHref) },
  touristType: ['Wildlife safari', 'Nature', 'Adventure'],
}];
---
<Base
  title={`${d.name} Safari`}
  description={clip(`${d.name} safari with Wingu Elite Adventures. ${d.short_description}`)}
  image={d.image?.src}
  imageAlt={d.name}
  crumbs={crumbs}
  schema={schema}
  overlayHeader
>
  <PageHero title={d.name} eyebrow={`${d.country.name} · ${d.region.name}`} lead={clip(d.short_description, 220)} image={d.image} crumbs={crumbs} size="lg" />

  <section class="section">
    <div class="container dest">
      <article class="prose" set:html={d.description_html} />
      <aside class="dest__aside">
        <div class="aside-card" data-plan data-slug={d.slug}>
          <span class="eyebrow">Plan a visit</span>
          <h2 class="h3">Experience {d.name} privately</h2>
          <p class="muted">Choose how long you’d like to stay. We’ll build the itinerary around {d.name}, with lodges, guides and transfers taken care of.</p>
          <DurationPicker days={3} nights={2} compact />
          <label class="plan-date">
            <span>Arrival <span class="muted">(optional)</span></span>
            <input type="date" class="input" data-plan-date />
          </label>
          <a href={`/bookings/?destination=${d.slug}&days=3&nights=2`} class="btn btn--block" data-plan-link>Request a quote <Icon name="arrow-right" /></a>
          <a href="/contact/" class="btn btn--outline btn--block">Ask a question</a>
        </div>
      </aside>
    </div>
  </section>

  {trips.length > 0 && (
    <section class="section section--sand">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Safaris here</span>
          <h2 class="h2">Journeys featuring {d.name}</h2>
        </div>
        <div class="grid grid--3">{trips.map((i) => <ItineraryCard itinerary={i} />)}</div>
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head section-head--split">
          <div><span class="eyebrow">Keep exploring</span><h2 class="h2">More in {d.country.name}{nearby.some((x) => x.country.slug !== d.country.slug) && ` & ${d.region.name}`}</h2></div>
          <a href={countryHref} class="btn btn--outline">All of {d.country.name} <Icon name="arrow-right" /></a>
        </div>
        <div class="grid grid--3">{nearby.map((x) => <DestinationCard destination={x} />)}</div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
<style>
  .dest { display: grid; gap: 3rem; }
  @media (min-width: 1100px) { .dest { grid-template-columns: 1fr 22rem; gap: 5rem; align-items: start; } }
  .dest__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .aside-card { display: grid; gap: 0.9rem; padding: 2rem; border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); }
  .plan-date { display: grid; gap: 0.35rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .plan-date .muted { text-transform: none; letter-spacing: 0; font-weight: 500; }
  .plan-date .input { min-height: 2.8rem; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const card = document.querySelector<HTMLElement>('[data-plan]');
    if (!card) return;
    const picker = card.querySelector<HTMLElement>('[data-duration]')!;
    const date = card.querySelector<HTMLInputElement>('[data-plan-date]')!;
    const link = card.querySelector<HTMLAnchorElement>('[data-plan-link]')!;
    date.min = new Date().toISOString().slice(0, 10);
    const update = () => {
      const q = new URLSearchParams({ destination: card.dataset.slug!, days: picker.dataset.days!, nights: picker.dataset.nights! });
      if (date.value) q.set('date', date.value);
      link.href = `/bookings/?${q}`;
    };
    picker.addEventListener('duration-change', update);
    date.addEventListener('change', update);
    update();
  });
</script>
