---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { gallery } from '../../lib/content';
const crumbs = [{ name: 'Gallery', href: '/gallery/' }];
---
<Base title="Safari Photo Gallery" description="Photos from real Wingu Elite Adventures safaris: Masai Mara wildlife, Kenyan landscapes, camps and unforgettable moments from our guests’ journeys." crumbs={crumbs}>
  <PageHero title="Moments from the wild" eyebrow="Gallery" lead="Real photographs from our guests’ journeys across Kenya." crumbs={crumbs} />
  <section class="section">
    <div class="container">
      {gallery.length > 0 ? (
        <div class="grid grid--3">
          {gallery.map((a) => (
            <article class="album" data-reveal>
              <div class="album__media"><Img image={a.cover} sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw" alt={a.name} /></div>
              <div class="album__body">
                <span class="album__count"><Icon name="camera" /> {a.images.length} photo{a.images.length === 1 ? '' : 's'}</span>
                <h2 class="h3"><a href={`/gallery/album/${a.slug}/`}>{a.name}</a></h2>
                {a.description && <p class="clamp-2">{a.description}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : <p class="lead">Albums are coming soon.</p>}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .album { position: relative; isolation: isolate; aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden; display: flex; align-items: flex-end; color: var(--cream); background: var(--ink); }
  .album__media { position: absolute; inset: 0; z-index: -1; }
  .album__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .album:hover .album__media :global(img) { transform: scale(1.05); }
  .album__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgb(39 29 15 / 0.88)); }
  .album__body { display: grid; gap: 0.4rem; padding: 1.75rem; }
  .album__body p { font-size: 0.92rem; color: rgb(247 242 234 / 0.8); }
  .album__body a { text-decoration: none; }
  .album__body a::after { content: ''; position: absolute; inset: 0; }
  .album__count { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-300); }
  .album__count :global(svg) { width: 1rem; height: 1rem; }
</style>
