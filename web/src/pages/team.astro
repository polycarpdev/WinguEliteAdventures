---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../lib/content';
const crumbs = [{ name: 'About us', href: '/about/' }, { name: 'Our team', href: '/team/' }];
---
<Base title="Our Team" description="Meet the guides, planners and safari specialists behind Wingu Elite Adventures, the people who make every journey seamless." crumbs={crumbs}>
  <PageHero title="The people behind your safari" eyebrow="Our team" lead="Guides, planners and storytellers who live and breathe the Kenyan wild." crumbs={crumbs} />
  <section class="section">
    <div class="container">
      {team.length > 0 ? (
        <div class="grid grid--3">
          {team.map((m) => (
            <article class="member" data-reveal>
              <div class="member__photo"><Img image={m.photo} sizes="(min-width: 1100px) 30vw, (min-width: 640px) 50vw, 100vw" alt={`${m.name}, ${m.role}`} /></div>
              <h2 class="h3">{m.name}</h2>
              <p class="member__role">{m.role}</p>
              <p class="muted">{m.bio}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="lead" style="text-align:center;margin-inline:auto">Our team will be introduced here soon.</p>
      )}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .member { display: grid; gap: 0.5rem; align-content: start; }
  .member__photo { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 0.75rem; background: var(--sand); }
  .member__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .member__role { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
</style>
