---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts } from '../../lib/content';
const crumbs = [{ name: 'Journal', href: '/blog/' }];
---
<Base title="Safari Journal: Kenya Travel Tips & Stories" description="Kenya safari advice, wildlife guides and travel stories from the Wingu Elite Adventures team: best time to visit, what to pack, where to go and more." crumbs={crumbs}>
  <PageHero title="The safari journal" eyebrow="Field notes" lead="Travel advice, wildlife stories and insider tips from our guides." crumbs={crumbs} />
  <section class="section"><div class="container"><BlogIndex list={posts} /></div></section>
  <CtaBand />
</Base>
