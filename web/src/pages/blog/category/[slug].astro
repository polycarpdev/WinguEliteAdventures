---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { categories, posts } from '../../../lib/content';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: { name: string; slug: string } };
const list = posts.filter((p) => p.category?.slug === c.slug);
const crumbs = [{ name: 'Journal', href: '/blog/' }, { name: c.name, href: `/blog/category/${c.slug}/` }];
---
<Base title={`${c.name}: Safari Journal`} description={`${c.name} articles from the Wingu Elite Adventures safari journal: Kenya travel advice and stories from our guides.`} crumbs={crumbs}>
  <PageHero title={c.name} eyebrow="Safari journal" crumbs={crumbs} />
  <section class="section"><div class="container"><BlogIndex list={list} active={c.slug} /></div></section>
  <CtaBand />
</Base>
