---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ItineraryCard from '../../components/ItineraryCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import DurationPicker from '../../components/DurationPicker.astro';
import { itineraries, testimonials, usd, clip, stripHtml, shortDuration, type Itinerary } from '../../lib/content';
const ON_REQUEST = 'On Request';
import { abs, ORG_ID } from '../../lib/schema';
import { site } from '../../config/site';

export function getStaticPaths() {
  return itineraries.map((i) => ({ params: { slug: i.slug }, props: { i } }));
}
const { i } = Astro.props as { i: Itinerary };
const reviews = testimonials.filter((t) => t.trip?.slug === i.slug).slice(0, 3);
const related = itineraries.filter((x) => x.slug !== i.slug).slice(0, 3);
const crumbs = [{ name: 'Packages', href: '/packages/' }, { name: i.title, href: `/packages/${i.slug}/` }];
const priced = i.price_from != null;
const description = clip(`${i.duration_label} private ${i.destination.name} package${priced ? ` from ${usd(i.price_from!)} per person` : ''}. ${i.summary || stripHtml(i.overview_html)}`);

const schema = [{
  '@type': 'TouristTrip',
  name: i.title,
  description: clip(i.overview_html, 300),
  url: abs(`/packages/${i.slug}/`),
  ...(i.image && { image: abs(i.image.src) }),
  touristType: ['Safari', 'Wildlife', 'Adventure'],
  provider: { '@id': ORG_ID },
  itinerary: {
    '@type': 'ItemList',
    numberOfItems: i.days.length,
    itemListElement: i.days.map((day) => ({
      '@type': 'ListItem',
      position: day.day_number,
      item: { '@type': 'TouristAttraction', name: `Day ${day.day_number}: ${day.title}`, description: clip(day.description_html, 200) },
    })),
  },
  offers: {
    '@type': 'Offer',
    ...(priced && { price: i.price_from!.toFixed(2), priceCurrency: site.currency }),
    availability: 'https://schema.org/InStock',
    url: abs(`/bookings/?package=${i.slug}`),
    seller: { '@id': ORG_ID },
  },
}];

const facts = [
  { icon: 'clock', label: 'Duration', value: i.duration_label },
  { icon: 'pin', label: 'Destination', value: i.destination.name },
  { icon: 'mountain', label: 'Activity level', value: i.difficulty_label },
  { icon: 'users', label: 'Group size', value: `Private · up to ${i.max_group_size}` },
] as const;
---
<Base title={`${i.title} | ${i.duration_label}`} description={description} image={i.image?.src} imageAlt={i.title} crumbs={crumbs} schema={schema} overlayHeader>
  <PageHero title={i.title} eyebrow={`${i.duration_label} · private package`} image={i.image} crumbs={crumbs} size="lg" />

  <div class="facts-bar">
    <div class="container facts">
      {facts.map((f) => (
        <div class="fact"><Icon name={f.icon} /><span><small>{f.label}</small>{f.value}</span></div>
      ))}
    </div>
  </div>

  <section class="section">
    <div class="container trip">
      <div class="trip__main">
        <section class="trip__block">
          <span class="eyebrow">Overview</span>
          <div class="prose" set:html={i.overview_html} />
        </section>

        {i.days.length > 0 && (
          <section class="trip__block">
            <span class="eyebrow">Day by day</span>
            <h2 class="h2">Your itinerary</h2>
            <ol class="timeline">
              {i.days.map((day, idx) => (
                <li class="timeline__day">
                  <span class="timeline__num">Day {day.day_number}</span>
                  <details class="timeline__card" open={idx === 0}>
                    <summary><h3 class="h3">{day.title}</h3><Icon name="chevron" /></summary>
                    <div class="prose prose--compact" set:html={day.description_html} />
                    {(day.accommodation || day.meals) && (
                      <p class="timeline__stay">
                        {day.accommodation && <span><Icon name="bed" /><strong>Stay:</strong> {day.accommodation}</span>}
                        {day.meals && <span><Icon name="check" /><strong>Meals:</strong> {day.meals}</span>}
                      </p>
                    )}
                  </details>
                </li>
              ))}
            </ol>
          </section>
        )}

        {(i.includes_html || i.excludes_html) && (
          <section class="trip__block incl">
            {i.includes_html && (
              <div class="incl__col incl__col--yes">
                <h2 class="h3"><Icon name="check" /> What’s included</h2>
                <div class="prose prose--compact" set:html={i.includes_html} />
              </div>
            )}
            {i.excludes_html && (
              <div class="incl__col incl__col--no">
                <h2 class="h3"><Icon name="x" /> Not included</h2>
                <div class="prose prose--compact" set:html={i.excludes_html} />
              </div>
            )}
          </section>
        )}
      </div>

      <aside class="trip__aside">
        <form class="book-card" data-book-card data-slug={i.slug} data-price={i.price_from ?? ''} data-days={i.duration_days} data-nights={i.duration_nights} action="/bookings/">
          <div class="book-card__top">
            {priced
              ? <p class="price book-card__price"><small>From</small>{usd(i.price_from!)}<span> per person</span></p>
              : <p class="price book-card__price book-card__price--request"><small>Price</small>{ON_REQUEST}<span> · tailored quote</span></p>}
            <span class="book-card__base">{shortDuration(i.duration_days, i.duration_nights)}</span>
          </div>
          <div class="book-card__field">
            <span class="book-card__label">Trip length</span>
            <DurationPicker days={i.duration_days} nights={i.duration_nights} compact />
          </div>
          <div class="book-card__row">
            <label class="book-card__field">
              <span class="book-card__label">Arrival</span>
              <input type="date" name="date" class="input" data-date />
            </label>
            <label class="book-card__field">
              <span class="book-card__label">Adults</span>
              <select name="adults" class="input" data-adults>
                {Array.from({ length: Math.max(i.max_group_size, 2) }, (_, n) => n + 1).map((n) => <option value={n} selected={n === 2}>{n}</option>)}
              </select>
            </label>
          </div>
          <p class="book-card__estimate" data-estimate aria-live="polite">
            {priced
              ? <>Estimated <strong>{usd(i.price_from! * 2)}</strong> for 2 adults, {i.duration_label.toLowerCase()}</>
              : <>We’ll send a tailored quote for 2 adults, {i.duration_label.toLowerCase()}, within 24 hours.</>}
          </p>
          <a href={`/bookings/?package=${i.slug}`} class="btn btn--lg btn--block" data-book-link>Book this package <Icon name="arrow-right" /></a>
          <ul class="book-card__points">
            <li><Icon name="check" /> Private vehicle & guide</li>
            <li><Icon name="check" /> Change days, nights & pace freely</li>
            <li><Icon name="check" /> Tailored quote within 24h, no payment now</li>
          </ul>
          {site.whatsapp
            ? <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi! I'm interested in the ${i.title} package (${i.duration_label}).`)}`} class="btn btn--outline btn--block" target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask on WhatsApp</a>
            : <a href="/contact/" class="btn btn--outline btn--block">Ask a question</a>}
        </form>
      </aside>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section section--sand">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Guest stories</span><h2 class="h2">Travellers on this package</h2></div>
        <div class="grid grid--3">{reviews.map((t) => <TestimonialCard t={t} />)}</div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><span class="eyebrow">You may also like</span><h2 class="h2">More packages</h2></div>
        <div class="grid grid--3">{related.map((x) => <ItineraryCard itinerary={x} />)}</div>
      </div>
    </section>
  )}

  <div class="mobile-book">
    <p class="price"><small>{shortDuration(i.duration_days, i.duration_nights)}{priced && ' · from'}</small>{priced ? usd(i.price_from!) : ON_REQUEST}</p>
    <a href={`/bookings/?package=${i.slug}`} class="btn" data-book-link>Book now</a>
  </div>

  <CtaBand />
</Base>

<script>
  // Package booking card: days/nights + date + adults -> live estimate and a
  // prefilled link to the booking form.
  document.addEventListener('astro:page-load', () => {
    const card = document.querySelector<HTMLFormElement>('[data-book-card]');
    if (!card) return;
    const picker = card.querySelector<HTMLElement>('[data-duration]')!;
    const date = card.querySelector<HTMLInputElement>('[data-date]')!;
    const adults = card.querySelector<HTMLSelectElement>('[data-adults]')!;
    const estimate = card.querySelector<HTMLElement>('[data-estimate]')!;
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-book-link]');
    const base = { days: Number(card.dataset.days), nights: Number(card.dataset.nights) };
    const price = Number(card.dataset.price);
    const usd = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    date.min = new Date().toISOString().slice(0, 10);
    card.addEventListener('submit', (e) => e.preventDefault());

    const update = () => {
      const days = Number(picker.dataset.days), nights = Number(picker.dataset.nights), a = Number(adults.value);
      const custom = days !== base.days || nights !== base.nights;
      // Scale the base price by days for a rough guide; the real quote is tailored.
      const est = Math.round((price * a * days) / base.days / 10) * 10;
      const who = `${plural(a, 'adult')}, ${plural(days, 'day')} / ${plural(nights, 'night')}`;
      estimate.innerHTML = (price ? `Estimated <strong>${usd(est)}</strong> for ${who}` : `We’ll send a tailored quote for ${who} within 24 hours.`) +
        (custom ? `<em>Custom length: we’ll tailor the itinerary and confirm the price.</em>` : '');
      const q = new URLSearchParams({ package: card.dataset.slug!, days: String(days), nights: String(nights), adults: String(a) });
      if (date.value) q.set('date', date.value);
      links.forEach((l) => (l.href = `/bookings/?${q}`));
    };
    picker.addEventListener('duration-change', update);
    date.addEventListener('change', update);
    adults.addEventListener('change', update);
    update();
  });
</script>

<style>
  .facts-bar { background: var(--white); border-bottom: 1px solid var(--line); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; padding-block: 1.5rem; }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .fact { display: flex; align-items: center; gap: 0.8rem; font-weight: 600; }
  .fact :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--gold); flex: none; }
  .fact span { display: grid; line-height: 1.3; }
  .fact small { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

  .trip { display: grid; gap: 3rem; }
  @media (min-width: 1100px) { .trip { grid-template-columns: 1fr 23rem; gap: 5rem; align-items: start; } }
  .trip__main { display: grid; gap: 4rem; min-width: 0; }
  .trip__block > .h2 { margin-bottom: 2rem; }

  .timeline { list-style: none; padding: 0; position: relative; display: grid; gap: 1rem; }
  .timeline::before { content: ''; position: absolute; left: 2.6rem; top: 1rem; bottom: 1rem; width: 1px; background: var(--line-strong); }
  .timeline__day { display: grid; grid-template-columns: 5.2rem 1fr; gap: 1rem; align-items: start; }
  .timeline__num {
    position: relative; z-index: 1; justify-self: center;
    padding: 0.4rem 0.7rem; border-radius: 999px; background: var(--olive); color: var(--cream);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; white-space: nowrap; margin-top: 1.1rem;
  }
  .timeline__card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .timeline__card summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.5rem; }
  .timeline__card summary::-webkit-details-marker { display: none; }
  .timeline__card summary :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--olive); flex: none; transition: transform 0.3s var(--ease); }
  .timeline__card[open] summary :global(svg) { transform: rotate(180deg); }
  .timeline__card .prose { padding: 0 1.5rem 1.2rem; }
  .timeline__stay { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0 1.5rem 1.4rem; padding-top: 0.9rem; border-top: 1px dashed var(--line-strong); font-size: 0.88rem; color: var(--ink-soft); }
  .timeline__stay span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .timeline__stay :global(svg) { width: 1rem; height: 1rem; color: var(--gold); }
  .book-card__price--request { font-size: 1.7rem !important; }
  @media (max-width: 639.98px) {
    .timeline::before { left: 0.75rem; }
    .timeline__day { grid-template-columns: 1fr; gap: 0.5rem; padding-left: 2rem; }
    .timeline__num { justify-self: start; margin-top: 0; }
  }

  .incl { display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .incl { grid-template-columns: 1fr 1fr; } }
  .incl__col { padding: 1.75rem; border-radius: var(--radius-lg); background: var(--sand); }
  .incl__col h2 { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .incl__col h2 :global(svg) { width: 1.4rem; height: 1.4rem; padding: 0.2rem; border-radius: 999px; color: var(--cream); }
  .incl__col--yes h2 :global(svg) { background: var(--olive); }
  .incl__col--no h2 :global(svg) { background: var(--muted); }

  .trip__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .book-card { display: grid; gap: 1.1rem; padding: 2rem; border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); }
  .book-card__price { font-size: 2.2rem; line-height: 1.1; }
  .book-card__price span { font-family: var(--sans); font-size: 0.9rem; color: var(--muted); }
  .book-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .book-card__base { padding: 0.35rem 0.7rem; border-radius: 999px; background: var(--gold-100); color: #7a5d1c; font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
  .book-card__field { display: grid; gap: 0.4rem; min-width: 0; }
  .book-card__label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .book-card__row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0.6rem; }
  .book-card__row .input { min-height: 2.8rem; padding: 0.55rem 0.75rem; }
  .book-card__estimate { padding: 0.75rem 0.9rem; border-radius: var(--radius-sm); background: var(--cream); font-size: 0.88rem; color: var(--ink-soft); }
  .book-card__estimate strong { color: var(--olive); font-size: 1.05rem; }
  .book-card__estimate :global(em) { display: block; font-style: normal; font-size: 0.8rem; color: var(--gold); margin-top: 0.15rem; }
  .book-card__points { list-style: none; padding: 0; display: grid; gap: 0.55rem; font-size: 0.93rem; }
  .book-card__points li { display: flex; gap: 0.6rem; align-items: center; }
  .book-card__points :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--olive); }

  .mobile-book { display: none; }
  @media (max-width: 1099.98px) {
    .trip__aside { position: static; }
    .mobile-book {
      position: fixed; z-index: 40; left: 0; right: 0; bottom: 0;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: 0.85rem var(--gutter) calc(0.85rem + env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgb(39 29 15 / 0.08);
    }
    .mobile-book .price { font-size: 1.3rem; line-height: 1.1; }
  }
</style>
