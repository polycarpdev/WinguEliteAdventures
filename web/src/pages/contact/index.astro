---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const schema = [{ '@type': 'ContactPage', name: 'Contact Wingu Elite Adventures', url: `${site.url}/contact/` }];
const tel = site.phone.replace(/\s/g, '');
const socials = Object.entries(site.social).filter(([, url]) => url) as [any, string][];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.name}, ${site.address.locality}, ${site.address.country}`)}`;
---
<Base title="Contact Us" description={`Contact Wingu Elite Adventures in ${site.address.locality}, Kenya. Call or WhatsApp ${site.phone}, email ${site.email}. We reply within 24 hours.`} crumbs={crumbs} schema={schema}>
  <PageHero title="Get in touch" eyebrow="We’re here to help" lead="Call, WhatsApp or email us. A real person replies, usually within the hour during office hours." crumbs={crumbs} />

  <section class="section">
    <div class="container contact">
      <a class="c-card c-card--lead" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Wingu Elite! I’d like help planning a trip.')}`} target="_blank" rel="noopener" data-astro-prefetch="false">
        <span class="c-card__icon c-card__icon--wa"><Icon name="whatsapp" /></span>
        <span class="c-card__label">Call or WhatsApp</span>
        <strong class="c-card__value">{site.phone}</strong>
        <span class="c-card__hint">Tap to chat on WhatsApp</span>
      </a>
      <a class="c-card" href={`tel:${tel}`}>
        <span class="c-card__icon"><Icon name="phone" /></span>
        <span class="c-card__label">Phone</span>
        <strong class="c-card__value">{site.phone}</strong>
        <span class="c-card__hint">Tap to call</span>
      </a>
      <a class="c-card" href={`mailto:${site.email}`}>
        <span class="c-card__icon"><Icon name="mail" /></span>
        <span class="c-card__label">Email</span>
        <strong class="c-card__value">{site.email}</strong>
        <span class="c-card__hint">Bookings: {site.bookingsEmail}</span>
      </a>
      <a class="c-card" href={mapUrl} target="_blank" rel="noopener" data-astro-prefetch="false">
        <span class="c-card__icon"><Icon name="pin" /></span>
        <span class="c-card__label">Office</span>
        <strong class="c-card__value">{site.address.locality}, {site.address.country}</strong>
        <span class="c-card__hint">East Africa · Open in Google Maps</span>
      </a>
      <div class="c-card c-card--hours">
        <span class="c-card__icon"><Icon name="clock" /></span>
        <span class="c-card__label">Opening hours (EAT)</span>
        <dl>
          {site.hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
        </dl>
      </div>
      <div class="c-card c-card--social">
        <span class="c-card__icon"><Icon name="globe" /></span>
        <span class="c-card__label">Follow us</span>
        <ul>
          <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a></li>
          {socials.map(([name, url]) => <li><a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a></li>)}
        </ul>
      </div>
    </div>

    <div class="container ready" data-reveal>
      <div>
        <span class="eyebrow">Ready to travel?</span>
        <h2 class="h2">Tell us your dates and we’ll do the rest</h2>
        <p class="lead">Pick a package or a destination, choose your days and nights, and get a tailored quote within 24 hours.</p>
      </div>
      <a href="/bookings/" class="btn btn--lg">Book now <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) { .contact { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .contact { grid-template-columns: repeat(3, 1fr); } }
  .c-card {
    display: grid; gap: 0.35rem; align-content: start; padding: 1.75rem; border-radius: var(--radius-lg);
    background: var(--white); box-shadow: var(--shadow-sm); text-decoration: none; min-width: 0;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  a.c-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .c-card__icon { display: grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: 0.6rem; border-radius: 999px; background: var(--sand); color: var(--olive); }
  .c-card__icon :global(svg) { width: 1.35rem; height: 1.35rem; }
  .c-card__icon--wa { background: #25d366; color: #fff; }
  .c-card__label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .c-card__value { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; color: var(--ink); overflow-wrap: anywhere; }
  .c-card__hint { font-size: 0.85rem; color: var(--olive); }
  .c-card--lead { background: var(--olive-900); }
  .c-card--lead .c-card__label { color: rgb(247 242 234 / 0.7); }
  .c-card--lead .c-card__value { color: var(--cream); font-size: 1.6rem; }
  .c-card--lead .c-card__hint { color: var(--gold-300); }
  .c-card--hours dl { display: grid; gap: 0.35rem; margin: 0.2rem 0 0; font-size: 0.95rem; }
  .c-card--hours dl div { display: flex; justify-content: space-between; gap: 1rem; }
  .c-card--hours dt { color: var(--muted); }
  .c-card--hours dd { margin: 0; font-weight: 600; }
  .c-card--social ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.3rem; }
  .c-card--social a { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--olive); transition: all 0.2s; }
  .c-card--social a:hover { background: var(--olive); border-color: var(--olive); color: var(--cream); }
  .c-card--social a :global(svg) { width: 1.2rem; height: 1.2rem; }
  .ready {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;
    margin-top: 2.5rem; padding: clamp(1.75rem, 4vw, 2.75rem); border-radius: var(--radius-lg); background: var(--sand);
  }
  .ready > div { display: grid; gap: 0.6rem; max-width: 40rem; }
</style>
