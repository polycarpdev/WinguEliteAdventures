---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
const crumbs = [{ name: 'Contact', href: '/contact/' }];
const schema = [{ '@type': 'ContactPage', name: 'Contact Wingu Elite Adventures', url: `${site.url}/contact/` }];
---
<Base title="Contact Us" description="Contact Wingu Elite Adventures in Nairobi, Kenya. Questions about a safari, a custom trip or a booking? Our team replies within 24 hours." crumbs={crumbs} schema={schema}>
  <PageHero title="Let’s talk safari" eyebrow="Get in touch" lead="A question, an idea, a dream trip? Write to us and a real person will reply within a day." crumbs={crumbs} />
  <section class="section">
    <div class="container contact">
      <form class="contact__form" data-contact-form novalidate>
        <div class="form-grid form-grid--2">
          <div class="field">
            <label for="name">Name <span class="req">*</span></label>
            <input id="name" name="name" class="input" autocomplete="name" maxlength="200" required />
            <p class="field-error" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input id="email" name="email" type="email" class="input" autocomplete="email" required />
            <p class="field-error" data-error-for="email"></p>
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" class="input" autocomplete="tel" maxlength="20" />
            <p class="field-error" data-error-for="phone"></p>
          </div>
          <div class="field">
            <label for="subject">Subject <span class="req">*</span></label>
            <input id="subject" name="subject" class="input" maxlength="200" required />
            <p class="field-error" data-error-for="subject"></p>
          </div>
          <div class="field span-2">
            <label for="message">Message <span class="req">*</span></label>
            <textarea id="message" name="message" class="input" maxlength="5000" rows="6" required></textarea>
            <p class="field-error" data-error-for="message"></p>
          </div>
        </div>
        <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <p class="form-alert" data-form-alert role="alert" tabindex="-1"></p>
        <button type="submit" class="btn btn--lg">Send message <Icon name="arrow-right" /></button>
      </form>

      <aside class="contact__info">
        <div class="info">
          <Icon name="mail" />
          <div><h2>Email</h2><a href={`mailto:${site.email}`}>{site.email}</a><a href={`mailto:${site.bookingsEmail}`}>{site.bookingsEmail}</a></div>
        </div>
        {(site.phone || site.whatsapp) && (
          <div class="info">
            <Icon name="phone" />
            <div>
              <h2>Phone</h2>
              {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>}
              {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp chat</a>}
            </div>
          </div>
        )}
        <div class="info">
          <Icon name="pin" />
          <div><h2>Office</h2><p>{site.address.locality}, {site.address.country}<br />East Africa</p></div>
        </div>
        <div class="info">
          <Icon name="clock" />
          <div><h2>Hours (EAT)</h2>{site.hours.map((h) => <p><span>{h.days}</span> {h.time}</p>)}</div>
        </div>
        <a href="/bookings/" class="btn btn--gold btn--block">Ready to book? Plan your safari</a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: 3rem; }
  @media (min-width: 1100px) { .contact { grid-template-columns: 1fr 22rem; gap: 4rem; align-items: start; } }
  .contact__form { display: grid; gap: 1.25rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow-sm); min-width: 0; }
  .contact__form > .btn { justify-self: start; }
  .contact__info { display: grid; gap: 1.25rem; padding: 2rem; border-radius: var(--radius-lg); background: var(--sand); }
  .info { display: flex; gap: 1rem; }
  .info > :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--gold); flex: none; margin-top: 0.2rem; }
  .info div { display: grid; gap: 0.15rem; font-size: 0.93rem; min-width: 0; }
  .info h2 { font-family: var(--sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.2rem; }
  .info a { color: var(--olive); text-decoration: none; word-break: break-all; }
  .info a:hover { text-decoration: underline; }
  .info span { display: inline-block; min-width: 8.5rem; color: var(--muted); }
</style>
<script>
  import { bindForm } from '../../lib/forms';
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (form) bindForm(form, '/api/contact/', '/contact/success/');
  });
</script>
