---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Message sent" description="Thank you, your message has been received." noindex>
  <section class="section">
    <div class="container container--narrow done">
      <span class="done__icon"><Icon name="check" /></span>
      <span class="eyebrow">Asante!</span>
      <h1 class="h1">Message received</h1>
      <p class="lead">Thank you for reaching out. We’ll get back to you within 24 hours.</p>
      <div class="done__actions">
        <a href="/" class="btn">Back to home</a>
        <a href="/packages/" class="btn btn--outline">Explore packages</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .done { display: grid; justify-items: center; text-align: center; gap: 1rem; padding-block: 3rem; }
  .done__icon { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 999px; background: var(--olive); color: var(--cream); margin-bottom: 0.5rem; }
  .done__icon :global(svg) { width: 2.2rem; height: 2.2rem; }
  .done__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
</style>
