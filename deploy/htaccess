# Generated by deploy/deploy.sh from deploy/htaccess. Edit that file, not this one.
# Apache serves the static Astro site directly; only /cockpit, /api and
# /ckeditor5 (and unknown URLs, for the 404 page) reach Django via Passenger.

PassengerAppRoot "__APP_DIR__/backend"
PassengerBaseURI "/"
PassengerPython "__PYTHON__"
PassengerAppEnv production
PassengerEnabled on

Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS and bare domain
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://wingueliteadventures.co.ke%{REQUEST_URI} [L,R=301,NE]

  # Pretty URLs: /about/ -> /about/index.html, served by Apache (never Django)
  RewriteCond %{REQUEST_URI} !^/(cockpit|api|ckeditor5)/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # Add the trailing slash the site uses: /about -> /about/
  RewriteCond %{REQUEST_URI} !^/(cockpit|api|ckeditor5|static|media)/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Fingerprinted build assets and fonts never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/(_astro|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images: a month.
  <If "%{REQUEST_URI} =~ m#^/(media|brand)/|\.(png|jpe?g|webp|svg|ico)$#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  # HTML: always revalidate so content edits show up immediately.
  <If "%{REQUEST_URI} =~ m#(/|\.html)$#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </If>
</IfModule>
