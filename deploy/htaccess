# BEGIN WINGU (managed by deploy/deploy.sh from deploy/htaccess; edit that file)
# The static Astro site is served straight from this folder. Requests for files
# that don't exist (/cockpit, /api, /ckeditor5, unknown URLs) fall through to
# Django via cPanel's Passenger block below. Works on LiteSpeed and Apache.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Never serve source, data or secrets, even if one lands here by mistake.
<FilesMatch "(\.(sqlite3|py|pyc|env|ini|log|sh|json|bak|sql|gz|zip)|^requirements\.txt)$">
  Order allow,deny
  Deny from all
</FilesMatch>
<FilesMatch "^site\.webmanifest$">
  Order allow,deny
  Allow from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS and bare domain
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://wingueliteadventures.co.ke%{REQUEST_URI} [L,R=301,NE]

  # Add the trailing slash the site uses: /about -> /about/
  RewriteCond %{REQUEST_URI} !^/(cockpit|api|ckeditor5|static|media)/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # Pretty URLs: /about/ -> /about/index.html, served as a static file
  RewriteCond %{REQUEST_URI} !^/(cockpit|api|ckeditor5)/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.html -f
  RewriteRule ^(.*/)?$ /$1index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # HTML revalidates every time so content edits show up immediately;
  # /_astro and /fonts carry their own long-cache .htaccess files.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
# END WINGU
